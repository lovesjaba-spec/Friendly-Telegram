<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b1f4e">
  <title>{% block title %}GeekTG{% endblock %}</title>
  <link rel="icon" href="https://github.com/lovesjaba-spec/Friendly-Telegram/raw/master/friendly-telegram/bot_avatar.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    :root{
      --bg:#081530; --surface:#16285a; --surface-2:#1d3470; --border:#33508f;
      --text:#eaf1ff; --muted:#9bb0d8; --accent:#3b9eff; --accent-2:#63b3ff;
      --danger:#ff6b6b; --success:#46d39a;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}
    body{
      font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
      color:var(--text);
      background:
        radial-gradient(900px 520px at 50% -8%, rgba(74,142,255,.45), transparent 70%),
        radial-gradient(720px 620px at 112% 108%, rgba(104,86,236,.34), transparent 70%),
        linear-gradient(165deg,#0a1c45 0%,#0c2156 46%,#081634 100%);
      background-attachment:fixed;
      display:flex;align-items:center;justify-content:center;
      min-height:100%;padding:24px;overflow-x:hidden;
    }
    a{color:var(--accent-2);text-decoration:none}
    a:hover{text-decoration:underline}
    .decor{position:fixed;inset:0;z-index:0;overflow:hidden;pointer-events:none}
    .decor span{position:absolute;border-radius:50%;filter:blur(96px);opacity:.5}
    .decor span:nth-child(1){width:440px;height:440px;background:#3f7fe6;top:-140px;left:-120px;animation:float1 19s ease-in-out infinite}
    .decor span:nth-child(2){width:380px;height:380px;background:#6a5cf0;bottom:-160px;right:-110px;animation:float2 23s ease-in-out infinite}
    .decor span:nth-child(3){width:320px;height:320px;background:#2bb6e0;top:42%;right:16%;animation:float1 27s ease-in-out infinite}
    @keyframes float1{0%,100%{transform:translate(0,0)}50%{transform:translate(44px,32px)}}
    @keyframes float2{0%,100%{transform:translate(0,0)}50%{transform:translate(-34px,-42px)}}
    .card{
      position:relative;z-index:1;width:100%;max-width:424px;
      background:linear-gradient(180deg,rgba(28,52,108,.82),rgba(18,36,80,.84));
      backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
      border:1px solid rgba(120,162,255,.18);border-radius:22px;
      padding:34px 30px;
      box-shadow:0 30px 80px rgba(4,12,40,.62),inset 0 1px 0 rgba(255,255,255,.07);
    }
    .brand{display:flex;align-items:center;gap:12px;margin-bottom:24px}
    .brand img{width:46px;height:46px;border-radius:13px;box-shadow:0 6px 18px rgba(4,12,40,.5)}
    .brand h1{font-size:19px;font-weight:700;letter-spacing:-.02em}
    .brand p{font-size:12.5px;color:var(--muted);margin-top:2px}
    .step-title{font-size:18px;font-weight:600;letter-spacing:-.01em}
    .step-sub{font-size:13.5px;color:var(--muted);margin:6px 0 18px;line-height:1.5}
    label.fld{display:block;font-size:12px;color:var(--muted);font-weight:500;margin:14px 0 6px}
    input.inp{
      width:100%;padding:12px 14px;font-size:14px;font-family:inherit;
      background:rgba(8,18,44,.55);border:1px solid var(--border);
      border-radius:11px;color:var(--text);outline:none;
      transition:border-color .15s,box-shadow .15s,background .15s;
    }
    input.inp:focus{
      border-color:var(--accent);background:rgba(8,18,44,.8);
      box-shadow:0 0 0 3px rgba(59,158,255,.2);
    }
    input.inp::placeholder{color:#5e72a0}
    .btn{
      display:flex;align-items:center;justify-content:center;gap:8px;
      width:100%;padding:12px 18px;margin-top:18px;
      font-family:inherit;font-size:14px;font-weight:600;
      border:none;border-radius:11px;cursor:pointer;color:#fff;
      background:linear-gradient(180deg,var(--accent),#2f86e6);
      box-shadow:0 10px 24px rgba(59,158,255,.32);
      transition:transform .08s,filter .15s,box-shadow .15s,opacity .15s;
    }
    .btn:hover{filter:brightness(1.08);box-shadow:0 12px 28px rgba(59,158,255,.42)}
    .btn:active{transform:scale(.985)}
    .btn[disabled]{opacity:.5;cursor:not-allowed;box-shadow:none}
    .btn.ghost{
      background:rgba(255,255,255,.04);border:1px solid var(--border);
      color:var(--text);box-shadow:none;
    }
    .btn.ghost:hover{background:rgba(99,179,255,.12);border-color:var(--accent);filter:none}
    .choice{display:flex;flex-direction:column;gap:12px}
    .choice button{
      display:flex;align-items:center;gap:14px;text-align:left;
      padding:15px 16px;border-radius:14px;border:1px solid var(--border);
      background:rgba(8,18,44,.45);color:var(--text);cursor:pointer;
      font-family:inherit;transition:border-color .15s,background .15s,transform .08s;
    }
    .choice button:hover{border-color:var(--accent);background:rgba(59,158,255,.12)}
    .choice button:active{transform:scale(.99)}
    .choice .ic{font-size:24px;line-height:1;width:28px;text-align:center;color:var(--accent-2)}
    .choice b{display:block;font-size:14.5px;font-weight:600}
    .choice small{color:var(--muted);font-size:12.5px}
    .hidden{display:none!important}
    .screen{animation:fade .26s ease}
    @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    .qr-wrap{display:flex;flex-direction:column;align-items:center;gap:16px;margin-top:6px}
    .qr-box{background:#fff;padding:14px;border-radius:16px;line-height:0;box-shadow:0 10px 30px rgba(4,12,40,.5)}
    .qr-box canvas{display:block;border-radius:4px}
    .status{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px}
    .dot{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent);animation:pulse 1.3s ease-in-out infinite}
    @keyframes pulse{0%,100%{opacity:.25}50%{opacity:1}}
    ol.steps{margin:14px 0 4px;padding-left:18px;color:var(--muted);font-size:13px;line-height:1.75}
    .back{
      display:block;margin:16px auto 0;padding:0;
      background:none;border:none;color:var(--muted);
      font-family:inherit;font-size:12.5px;cursor:pointer;
    }
    .back:hover{color:var(--accent-2)}
    .foot{margin-top:26px;text-align:center;font-size:11px;color:#5b709e;letter-spacing:.02em}
    @media (max-width:480px){.card{padding:28px 22px}}
  </style>
  {% block head %}{% endblock %}
</head>
<body>
  <div class="decor"><span></span><span></span><span></span></div>
  {% block body %}{% endblock %}
</body>
</html>
