{% extends "base.jinja2" %}
{% block title %}GeekTG{% endblock %}

{% block body %}
<div class="card" style="text-align:center">
  <div class="brand" style="justify-content:center">
    <img src="https://github.com/lovesjaba-spec/Friendly-Telegram/raw/master/friendly-telegram/bot_avatar.png" alt="">
    <div style="text-align:left">
      <h1>GeekTG</h1>
      <p>Friendly-Telegram userbot</p>
    </div>
  </div>

  <div class="step-title">Userbot is running</div>
  <div class="step-sub" style="margin-bottom:6px">
    GeekTG is online and listening for your commands in Telegram.
  </div>

  <button class="btn ghost" id="restart">↻ Restart userbot</button>

  <div class="foot">GeekTG · Friendly-Telegram · AGPLv3</div>
</div>

<script>
(function(){
  var dark = '#16285a', light = '#eaf1ff';
  document.getElementById('restart').onclick = function(){
    Swal.fire({
      title:'Restart the userbot?',
      icon:'question',
      background:dark,color:light,
      showCancelButton:true,confirmButtonText:'Restart',
      showLoaderOnConfirm:true,
      allowOutsideClick:function(){ return !Swal.isLoading(); },
      preConfirm:function(){
        return fetch('/restart',{method:'POST'})
          .then(function(){
            return new Promise(function(resolve){
              setTimeout(function(){
                var t = setInterval(function(){
                  fetch('/is_restart_complete')
                    .then(function(){ clearInterval(t); resolve(true); })
                    .catch(function(){});
                }, 1500);
              }, 3000);
            });
          })
          .catch(function(){ Swal.showValidationMessage('Restart failed'); });
      }
    }).then(function(res){ if(res.value){ location.reload(); } });
  };
})();
</script>
{% endblock %}
