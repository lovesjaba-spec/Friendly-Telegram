{% extends "base.jinja2" %}
{% block title %}GeekTG · Setup{% endblock %}

{% block head %}
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
{% endblock %}

{% block body %}
<div class="card">
  <div class="brand">
    <img src="https://github.com/lovesjaba-spec/Friendly-Telegram/raw/master/friendly-telegram/bot_avatar.png" alt="">
    <div>
      <h1>GeekTG</h1>
      <p>Friendly-Telegram setup</p>
    </div>
  </div>

  <div id="s-api" class="screen hidden">
    <div class="step-title">Telegram API</div>
    <div class="step-sub">
      Create an application at
      <a href="https://my.telegram.org/apps" target="_blank" rel="noopener">my.telegram.org</a>
      and paste the credentials below.
    </div>
    <label class="fld" for="api_id">API ID</label>
    <input class="inp" id="api_id" placeholder="2020" inputmode="numeric" autocomplete="off">
    <label class="fld" for="api_hash">API hash</label>
    <input class="inp" id="api_hash" placeholder="w7i07l02i6hymgg03ncq6esmr3t4c9kl" autocomplete="off">
    <button class="btn" id="api_next">Continue</button>
  </div>

  <div id="s-method" class="screen hidden">
    <div class="step-title">Sign in</div>
    <div class="step-sub">Choose how to log into your Telegram account.</div>
    <div class="choice">
      <button type="button" id="m-qr">
        <span class="ic">▦</span>
        <span><b>QR code</b><small>Scan with Telegram — fastest</small></span>
      </button>
      <button type="button" id="m-phone">
        <span class="ic">✆</span>
        <span><b>Phone number</b><small>Get a login code in Telegram</small></span>
      </button>
    </div>
  </div>

  <div id="s-qr" class="screen hidden">
    <div class="step-title">Scan QR code</div>
    <ol class="steps">
      <li>Open Telegram on your phone</li>
      <li>Settings → Devices → Link Desktop Device</li>
      <li>Point the camera at this code</li>
    </ol>
    <div class="qr-wrap">
      <div class="qr-box"><canvas id="qr"></canvas></div>
      <div class="status"><span class="dot"></span><span id="qr-status">Waiting for scan…</span></div>
    </div>
    <button type="button" class="back" data-to="s-method">← Other methods</button>
  </div>

  <div id="s-phone" class="screen hidden">
    <div class="step-title">Phone number</div>
    <div class="step-sub">A one-time login code will be sent to your Telegram.</div>
    <label class="fld" for="phone">Phone number</label>
    <input class="inp" id="phone" placeholder="+79991234567" inputmode="tel" autocomplete="off">
    <button class="btn" id="phone_next">Send code</button>
    <button type="button" class="back" data-to="s-method">← Other methods</button>
  </div>

  <div class="foot">GeekTG · Friendly-Telegram · AGPLv3</div>
</div>

<script>
(function(){
  var apiDone = {{ 'true' if api_done else 'false' }};
  var screens = ['s-api','s-method','s-qr','s-phone'];
  var qrTimer = null, qrUrl = '', lastCode = '';
  var dark = '#16285a', light = '#eaf1ff';

  function show(id){
    screens.forEach(function(s){
      document.getElementById(s).classList.toggle('hidden', s !== id);
    });
    if(id !== 's-qr'){ stopQr(); }
  }
  function err(t){ Swal.fire({icon:'error',title:t,background:dark,color:light}); }
  function ok(t){
    return Swal.fire({icon:'success',title:t,timer:1100,showConfirmButton:false,background:dark,color:light});
  }
  function finish(){
    fetch('/finishLogin',{method:'POST',body:'',credentials:'include'})
      .then(function(r){
        if(!r.ok){ err('Login confirmation failed'); return; }
        ok('Signed in!').then(function(){ location.reload(); });
      })
      .catch(function(){ err('Login confirmation failed'); });
  }

  document.querySelectorAll('.back').forEach(function(b){
    b.onclick = function(){ show(b.dataset.to); };
  });

  document.getElementById('api_next').onclick = function(){
    var id = document.getElementById('api_id').value.trim();
    var hash = document.getElementById('api_hash').value.trim();
    if(!/^\d{4,}$/.test(id)){ err('API ID looks invalid'); return; }
    if(hash.length !== 32){ err('API hash must be 32 characters'); return; }
    var btn = this; btn.disabled = true;
    fetch('/setApi',{method:'PUT',body:hash+id,credentials:'include'})
      .then(function(r){
        btn.disabled = false;
        if(!r.ok){ err('Could not save credentials'); return; }
        show('s-method');
      })
      .catch(function(){ btn.disabled = false; err('Could not save credentials'); });
  };

  document.getElementById('m-qr').onclick = function(){ show('s-qr'); startQr(); };
  document.getElementById('m-phone').onclick = function(){ show('s-phone'); };

  function drawQr(url){
    if(url === qrUrl){ return; }
    qrUrl = url;
    QRCode.toCanvas(document.getElementById('qr'), url,
      {width:232,margin:1,color:{dark:'#0b1c40',light:'#ffffff'}}, function(){});
  }
  function stopQr(){ if(qrTimer){ clearInterval(qrTimer); qrTimer = null; } }

  function startQr(){
    document.getElementById('qr-status').textContent = 'Waiting for scan…';
    fetch('/qrLogin',{method:'POST',credentials:'include'})
      .then(function(r){ if(!r.ok){ throw 0; } return r.json(); })
      .then(function(d){ drawQr(d.url); stopQr(); qrTimer = setInterval(pollQr,2200); })
      .catch(function(){ err('Could not start QR login'); });
  }
  function pollQr(){
    fetch('/qrStatus',{credentials:'include'})
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(d.status === 'pending'){ if(d.url){ drawQr(d.url); } }
        else if(d.status === '2fa'){ stopQr(); ask2fa(); }
        else if(d.status === 'done'){
          stopQr();
          document.getElementById('qr-status').textContent = 'Authorized';
          finish();
        }
        else if(d.status === 'error'){ stopQr(); err('QR login failed — try another method'); }
      })
      .catch(function(){});
  }
  function ask2fa(){
    Swal.fire({
      title:'Two-step verification',
      input:'password',
      inputPlaceholder:'Your 2FA password',
      background:dark,color:light,
      confirmButtonText:'Confirm',showLoaderOnConfirm:true,
      allowOutsideClick:function(){ return !Swal.isLoading(); },
      preConfirm:function(pw){
        return fetch('/qr2fa',{method:'POST',body:pw||'',credentials:'include'})
          .then(function(r){
            if(r.status === 403){ Swal.showValidationMessage('Wrong password'); return; }
            if(!r.ok){ Swal.showValidationMessage('Server error'); return; }
            return true;
          })
          .catch(function(){ Swal.showValidationMessage('Network error'); });
      }
    }).then(function(res){ if(res.value){ finish(); } });
  }

  document.getElementById('phone_next').onclick = function(){
    var phone = document.getElementById('phone').value.trim();
    if(!/^[+]?\d{10,15}$/.test(phone)){ err('Phone number looks invalid'); return; }
    var btn = this; btn.disabled = true;
    fetch('/sendTgCode',{method:'POST',body:phone,credentials:'include'})
      .then(function(r){
        btn.disabled = false;
        if(!r.ok){ err('Could not send the code'); return; }
        askCode(phone);
      })
      .catch(function(){ btn.disabled = false; err('Could not send the code'); });
  };
  function askCode(phone){
    Swal.fire({
      title:'Enter login code',
      input:'text',
      inputPlaceholder:'12345',
      background:dark,color:light,
      confirmButtonText:'Confirm',showLoaderOnConfirm:true,
      allowOutsideClick:function(){ return !Swal.isLoading(); },
      preConfirm:function(code){
        lastCode = code || '';
        return fetch('/tgCode',{method:'POST',body:lastCode+'\n'+phone+'\n'})
          .then(function(r){
            if(r.ok){ return 'done'; }
            if(r.status === 401){ return '2fa'; }
            if(r.status === 403){ Swal.showValidationMessage('Code is incorrect'); return; }
            if(r.status === 404){ Swal.showValidationMessage('Code has expired'); return; }
            Swal.showValidationMessage('Server error');
          })
          .catch(function(){ Swal.showValidationMessage('Network error'); });
      }
    }).then(function(res){
      if(res.value === 'done'){ finish(); }
      else if(res.value === '2fa'){ askPhone2fa(phone); }
    });
  }
  function askPhone2fa(phone){
    Swal.fire({
      title:'Two-step verification',
      input:'password',
      inputPlaceholder:'Your 2FA password',
      background:dark,color:light,
      confirmButtonText:'Confirm',showLoaderOnConfirm:true,
      allowOutsideClick:function(){ return !Swal.isLoading(); },
      preConfirm:function(pw){
        return fetch('/tgCode',{method:'POST',body:lastCode+'\n'+phone+'\n'+(pw||'')})
          .then(function(r){
            if(r.ok){ return true; }
            if(r.status === 403){ Swal.showValidationMessage('Wrong password'); return; }
            Swal.showValidationMessage('Server error');
          })
          .catch(function(){ Swal.showValidationMessage('Network error'); });
      }
    }).then(function(res){ if(res.value){ finish(); } });
  }

  show(apiDone ? 's-method' : 's-api');
})();
</script>
{% endblock %}
